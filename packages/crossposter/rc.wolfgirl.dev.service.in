[Unit]
Description=PolyWolf's Post Composer
After=network.target
StartLimitIntervalSec=0

[Install]
WantedBy=default.target

[Service]
Type=simple
Restart=always
RestartSec=10
WorkingDirectory=@rc-wolfgirl-dev@
ExecStart=@rc-wolfgirl-dev@/bin/rc-crossposter
# TODO: configure these variables in Nix?
Environment="SANIC_PROXY_SECRET=_rc.wolfgirl.dev"
Environment="RC_DRAFTS_DIR=/var/opt/syncthing/Notes"
Environment="RC_WEBSITE_DIR=/home/ubuntu/wolfgirl.dev"
